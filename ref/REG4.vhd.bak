LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY REG4 IS
	PORT (REG_IN	:	IN STD_LOGIC_VECTOR(3 DOWNTO 0);
			CLK		:	IN STD_LOGIC;
			CLEAR		:	IN STD_LOGIC;
			REG_OUT	:	OUT STD_LOGIC_VECTOR(3 DOWNTO 0));
END REG4;

ARCHITECTURE LOGIC OF REG4 IS
	BEGIN
		PROCESS(CLK, CLEAR)
		BEGIN
			IF CLEAR = '1' THEN
				REG_OUT <= "0000";
				
			ELSIF CLK'EVENT AND CLK = '1' THEN
				REG_OUT <= REG_IN;
				
			END IF;
		END PROCESS;
END LOGIC;
		